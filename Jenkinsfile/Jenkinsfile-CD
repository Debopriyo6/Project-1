pipeline {

    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Docker image tag'
        )
    }

    environment {
        IMAGE_NAME = "debopriyoray662001824/backend-application"
        K8S_NAMESPACE = "default"
        DEPLOYMENT_NAME = "backend-application"
    }

    stages {

        stage('Check Kubernetes Connection') {
            steps {
                sh '''
                    echo "Checking cluster connection..."
                    kubectl get nodes
                '''
            }
        }

        stage('Verify Deployment YAML') {
            steps {
                sh '''
                    echo "Checking repository structure..."
                    ls -R

                    if [ ! -f k8s/deployment.yaml ]; then
                        echo "ERROR: k8s/deployment.yaml not found"
                        exit 1
                    fi

                    echo "Deployment YAML found"
                '''
            }
        }

        stage('Apply Kubernetes Manifests') {
            steps {
                sh '''
                    echo "Applying Kubernetes YAML..."
                    kubectl apply -f k8s/deployment.yaml
                '''
            }
        }

        stage('Deploy Image Update') {
            steps {
                sh """
                    echo "Updating image in deployment..."

                    kubectl set image deployment/${DEPLOYMENT_NAME} \
                    backend-container=${IMAGE_NAME}:${IMAGE_TAG} \
                    -n ${K8S_NAMESPACE}
                """
            }
        }

        stage('Verify Rollout') {
            steps {
                sh """
                    kubectl rollout status deployment/${DEPLOYMENT_NAME} \
                    -n ${K8S_NAMESPACE}
                """
            }
        }

        stage('Show Pods') {
            steps {
                sh """
                    kubectl get pods -n ${K8S_NAMESPACE}
                """
            }
        }
    }

    post {

        success {
            echo "✅ Deployment successful"
            echo "Image deployed: ${IMAGE_NAME}:${IMAGE_TAG}"
        }

        failure {
            echo "❌ Deployment failed"
        }
    }
}